      <section  data-background-image="images/puzzle.jpg">
        <h1>Design goals: Decoupled development</h1>
            <p style="margin-top:100px"><hl>cooker</hl> uses a plugin architecture. </p>
            <ul >
                <li>Plugins are shared libraries that are loaded at runtime</li>
                <li>Can be developed independently by different teams in the collaboration</li>
                <li>Broken plugins can be easily disabled.</li>
                <li>Separation of concerns: A plugin does one task(-family). Limited interface to other plugins, data flow explicit.</li>
                <li>Plugins can be easily exchanged: easy to try and compare different algorithms for the same task.</li> 

                    </ul>


                  <script style="zoom:3" type="text/tikz" alt="Plugin hierarchy example for MUSE">
                 
                  \begin{document}
                 \usetikzlibrary{arrows.meta}
                 \begin{tikzpicture}[
  node distance=1.2cm,
  column/.style={rectangle, draw=none, font=\sffamily\Large\bfseries\color{cyan}, text width=5cm, align=center},
   or/.style={rectangle, draw=none, font=\sffamily\bfseries\color{cyan}, text width=5cm, align=center},
  plugin/.style={rectangle, draw=white, rounded corners, minimum width=4cm, minimum height=0.7cm, font=\sffamily\small, text=white, align=center},
  arrow/.style={-{Triangle[width=8mm,length=6mm]}, line width=3mm, white}
]
% Column titles (top-aligned)
\node[column] (dataTitle) at (0,3.5) {Data Source};
\node[column] (detectorTitle) at (5,3.5) {Detector-level};
\node[column] (trackingTitle) at (10,3.5) {Tracking};
\node[column] (highlevelTitle) at (15,3.5) {High level};

% Data Source nodes (centered)
\node[plugin] (raw) at (0,0.6) {Raw data};
\node[or] (genfit) at (0,0) {-or-};

\node[plugin] (mc) at (0,-0.6) {MC + digitization};

% Detector-level nodes (centered)
\node[plugin] (straw) at (5,2.4) {StrawTube};
\node[plugin] (gem) at (5,1.6) {GEM};
\node[plugin] (veto) at (5,0.8) {Veto};
\node[plugin] (beam) at (5,0) {Beam Monitor};
\node[plugin] (sps) at (5,-0.8) {SPS};
\node[plugin] (calo) at (5  ,-1.6) {Calo};
\node[plugin] (calo) at (5  ,-2.4) {...};


% Tracking nodes (centered)
\node[plugin] (genfit) at (10,1.8) {GenFit};
\node[or] (genfit) at (10,1.2) {-or-};

\node[plugin] (lsqr) at (10,+0.6) {LSQR};
\node[or] (genfit) at (10,0) {-or-};

\node[plugin] (aiml) at (10,-0.6) {AI/ML};
\node[or] (genfit) at (10,-1.2) {-or-};
