\node[plugin] (physics) at (15,-0.4) {Physics analaysis Student B};

\node[plugin] (physics) at (15,-1.2) {...};

% Arrows (center height)
\draw[arrow] (2,0) -- (3,0);
\draw[arrow] (7,0) -- (8,0);
\draw[arrow] (12,0) -- (13,0);

\end{tikzpicture}
                 
                 
                  \end{document}
